<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.factory</groupId>
    <artifactId>device-hub</artifactId>
    <version>1.0.29</version>
    <name>device-hub</name>
    <description>工厂设备联网采集与监控脚手架</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- 登录与角色。用 session 不用 JWT：单机部署、前后端同源，
             session 更简单，还能天然支持"退出登录"和"改密码后强制下线" -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- 数据库：MySQL 8 是默认也是唯一推荐的库（2026-10-27 起 H2 已废弃，
             后续 ERP 集成、长期数据、与 ERP 共库都要求真数据库）。
             驱动必须在包里——现场换连接只改配置，不能要求客户重新打包。
             PG 驱动保留给有特殊要求的客户。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 串口通讯，Modbus RTU 用。纯 Java 实现，免装驱动 -->
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>2.10.4</version>
        </dependency>

        <!-- OPC UA 客户端（Eclipse Milo）。为什么用它：西门子 S7-1500、汇川、
             欧姆龙 NX 等新 PLC 默认带 OPC UA Server，是比 Modbus 更现代的统一入口；
             纯 Java、无原生依赖，和"一个安装包"的交付方式兼容。
             版本锁 0.6.x：API 稳定；milo 0.6.11 声明的是 Netty 4.1.97，
             而 Spring Boot 4.1.2 统一带的是 Netty 4.2.19.Final —— 跨大版本但已实测二进制兼容
             （2026-11-06：建会话 / 批量读 / 写入 全通，见 OpcUaDriverLocalServerTest）。 -->
        <dependency>
            <groupId>org.eclipse.milo</groupId>
            <artifactId>sdk-client</artifactId>
            <version>0.6.11</version>
        </dependency>

        <!-- OPC UA 本地测试服务器（Eclipse Milo sdk-server，与 sdk-client 同版本 0.6.11）。
             只在 test 作用域：现场真机是 S7-200，不支持 OPC UA，要证明驱动代码本身
             在 Boot 4.1.2 下能建会话、读到点位值，只能本地起一个真 OPC UA Server 连。
             生产代码不依赖它，交付包里也不会有它。 -->
        <dependency>
            <groupId>org.eclipse.milo</groupId>
            <artifactId>sdk-server</artifactId>
            <version>0.6.11</version>
            <scope>test</scope>
        </dependency>

        <!-- milo 0.6.11 的 stack-core 用的是 JAXB 2 的 javax.xml.bind.DatatypeConverter
             （NodeId.parse() 解析 ByteString 节点号 ns=2;b=... 时会调它），
             但 Spring Boot 4 把 jaxb-runtime 统一管理成 4.0.9（jakarta 命名空间），
             javax.xml.bind 在 Boot 4 的类路径上整个消失。
             ⇒ 交付 jar 里 javax/xml/bind 计数为 0，客户只要配一个 ByteString 节点号，
               采集线程里就会抛 NoClassDefFoundError，现场表现是「设备在线但读不到任何点」。
             所以这里必须是 runtime 作用域（不是 test）：javax 命名空间与 Boot 4 自带的
             jakarta 命名空间包名不同、可共存，不冲突。
             将来若 milo 换了实现不再引用 javax.xml.bind，这个依赖就可以删掉 ——
             OpcUaDriverBoot4ClasspathTest 里有一条断言专门盯这件事。 -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>

        <!-- 报表导出 xlsx。选 POI 而不是手搓 XML：厂里要打印、要贴进月报，
             格式错了客户第一眼就否掉。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>device-hub</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              默认**排除** @Tag("integration") 的测试，只跑纯单测。

              为什么必须排除（不是图快，是为了保住两个特性）：
                ① 「mvn test 在没有任何数据库的机器上也全绿」——现在是 409 个纯 Mockito 用例，
                   55 秒跑完。若不排除，集成测试会让它依赖 MySQL，本地没库就红。
                ② 门禁的 surefire 基线是 **409 用例 / 51 报告**（tools/test-baseline.json）。
                   不排除的话基线数会变，而基线是用来抓「测试类没被收集」的（只许增不许减）。
                   ⇒ 把集成测试隔离在另一个分组里，两边的判据都保持干净。

              要跑集成测试：
                mvn test -Pintegration
              （CI 就是这么跑的，见 .github/workflows/ci.yml）

              ⚠️ **不要用 `-DexcludedGroups=` 传空值来覆盖**（2026-11-07 实测踩到）：
                 Maven 会忽略空属性 ⇒ pom 里的 excludedGroups=integration 仍然生效，
                 而 include 也是 integration ⇒ **一个测试都不跑，却 exit 0** ⇒ 假绿。
                 必须用下面的 profile（`combine.self="override"`）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          集成测试专用 profile：mvn test -Pintegration
          覆盖掉上面默认的 excludedGroups，改成「只跑 integration 组」。
          `combine.self="override"` 是关键：没有它，Maven 会把 profile 配置与 base 配置
          **合并** ⇒ excludedGroups 仍然是 integration ⇒ 又是 0 个测试。
        -->
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups combine.self="override">none</excludedGroups>
                            <groups combine.self="override">integration</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
