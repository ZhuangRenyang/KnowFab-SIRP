<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.factory</groupId>
    <artifactId>device-hub</artifactId>
    <version>1.0.29</version>
    <name>device-hub</name>
    <description>工厂设备联网采集与监控脚手架</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- 登录与角色。用 session 不用 JWT：单机部署、前后端同源，
             session 更简单，还能天然支持"退出登录"和"改密码后强制下线" -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- 数据库：MySQL 8 是默认也是唯一推荐的库（2026-10-27 起 H2 已废弃，
             后续 ERP 集成、长期数据、与 ERP 共库都要求真数据库）。
             驱动必须在包里——现场换连接只改配置，不能要求客户重新打包。
             PG 驱动保留给有特殊要求的客户。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 串口通讯，Modbus RTU 用。纯 Java 实现，免装驱动 -->
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>2.10.4</version>
        </dependency>

        <!-- OPC UA 客户端（Eclipse Milo）。为什么用它：西门子 S7-1500、汇川、
             欧姆龙 NX 等新 PLC 默认带 OPC UA Server，是比 Modbus 更现代的统一入口；
             纯 Java、无原生依赖，和"一个安装包"的交付方式兼容。
             版本锁 0.6.x：API 稳定，Netty 4.1 与 Spring Boot 3.2 兼容。 -->
        <dependency>
            <groupId>org.eclipse.milo</groupId>
            <artifactId>sdk-client</artifactId>
            <version>0.6.11</version>
        </dependency>

        <!-- OPC UA 本地测试服务器（Eclipse Milo sdk-server，与 sdk-client 同版本 0.6.11）。
             只在 test 作用域：现场真机是 S7-200，不支持 OPC UA，要证明驱动代码本身
             在 Boot 4.1.2 下能建会话、读到点位值，只能本地起一个真 OPC UA Server 连。
             生产代码不依赖它，交付包里也不会有它。 -->
        <dependency>
            <groupId>org.eclipse.milo</groupId>
            <artifactId>sdk-server</artifactId>
            <version>0.6.11</version>
            <scope>test</scope>
        </dependency>

        <!-- milo 0.6.11 的 stack-core 用的是 JAXB 2 的 javax.xml.bind.DatatypeConverter，
             但 Spring Boot 4 把 jaxb-runtime 统一管理成 4.0.9（jakarta 命名空间），
             javax.xml.bind 在 Boot 4 的类路径上整个消失。
             这里只在 test 作用域补回 jaxb-api 2.3.1，让本地 OPC UA Server 能起来；
             客户端二进制通道不碰它（见 OpcUaDriverBoot4ClasspathTest 的断言）。
             ⚠️ 若现场点位用 ByteString 节点号（ns=2;b=...），生产运行时需要把它提到 runtime 作用域。 -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
            <scope>test</scope>
        </dependency>

        <!-- 报表导出 xlsx。选 POI 而不是手搓 XML：厂里要打印、要贴进月报，
             格式错了客户第一眼就否掉。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>device-hub</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
